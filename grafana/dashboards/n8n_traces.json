        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P7E2AE7DB8179C128"
          },
          "editorMode": "code",
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"n8n\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "n8n spans/s",
          "range": true,
          "refId": "A"
